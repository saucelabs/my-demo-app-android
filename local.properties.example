# Copy the relevant values into the gitignored local.properties file.
# Keep the existing sdk.dir entry generated by Android Studio.

# Build the demo against a locally built Sauce Mobile Beta AAR.
sauceMobileBetaAar=/absolute/path/to/testfairy-android-sdk/sauce-mobile-beta-android/build/outputs/aar/sauce-mobile-beta-android-release.aar

# Alternatively, comment out sauceMobileBetaAar and use a published artifact.
# sauceMobileBetaVersion=<version>
# sauceMobileBetaRepository=https://maven.testfairy.com

# Runtime configuration. Never commit real values.
backtraceSubmissionUrl=https://submit.backtrace.io/<universe>/<token>/json
sauceMobileBetaToken=<sauce-mobile-beta-token>
sauceEnvironment=beta

# Optional MAD build/distribution correlation value.
sauceDistributionId=
